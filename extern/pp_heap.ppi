
handle PP_AllocBytes :: ptr[uint8] drop pp_alloc_bytes_free;
extern func pp_alloc_bytes_allocate :: (n :: uint64) -> PP_AllocBytes;
extern func pp_alloc_bytes_clear_allocate :: (n :: uint64) -> PP_AllocBytes;
// Mutable borrow: realloc releases the old block itself and stores the new token in the slot, so the
// caller's scope drop still releases the final allocation exactly once.
extern func pp_alloc_bytes_reallocate :: (pab :: PP_AllocBytes&, n :: uint64) -> int32;
extern func pp_alloc_bytes_free :: (ab :: ptr[uint8]) -> void;
